rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private save: only the signed-in owner. Capped to ~900 KB (Firestore doc limit is 1 MiB).
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map;
      allow delete: if false;
    }

    // Public leaderboard profile: anyone signed in can read, only the owner can write their own.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'farmName', 'level', 'xp', 'peso', 'score', 'updatedAt', 'mutations', 'harvests', 'bestSale', 'seasonId', 'seasonEarned'])
        && request.resource.data.get('mutations', 0) is int && request.resource.data.get('harvests', 0) is int
        && request.resource.data.get('bestSale', 0) is int && request.resource.data.get('seasonEarned', 0) is int
        && request.resource.data.get('seasonId', '') is string
        && request.resource.data.username is string && request.resource.data.username.size() <= 20
        && request.resource.data.farmName is string && request.resource.data.farmName.size() <= 24
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 100
        && request.resource.data.xp is int && request.resource.data.peso is int
        && request.resource.data.score is int;
      allow delete: if false;
    }

    // World chat: signed-in players read; anyone can post as THEMSELVES only (username is checked against their login).
    // Messages are immutable. Add a TTL policy on `expireAt` so old messages delete themselves (see FIREBASE_SETUP.md).
    match /chat/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'level', 'createdAt', 'expireAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == request.auth.token.email.split('@')[0]
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 140
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp;
      allow update, delete: if false;
    }
  }
}
